# ==============================================================================
# HostelHub Production Docker Environment Configuration
# Copy this file to .env before running: docker compose up -d --build
# ==============================================================================

# 1. Your Domain Name
# Set this to your actual registered domain or subdomain (e.g., example.com or hms.example.com)
DOMAIN=yourdomain.com

# Email address for Let's Encrypt SSL certificate issuance and renewal notifications
ACME_EMAIL=admin@yourdomain.com

# Frontend origin for CORS policy (defaults to https://${DOMAIN} if left as below)
CORS_ORIGIN=https://yourdomain.com

# 2. Database Credentials
DB_NAME=hostel_management
DB_USER=hms_user
DB_PASSWORD=replace_with_a_strong_database_password
DB_ROOT_PASSWORD=replace_with_a_strong_mysql_root_password

# 3. Authentication Secrets
# Generate two DIFFERENT random 64-character hex strings with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_jwt_access_secret_min_32_characters_111111
JWT_REFRESH_SECRET=replace_with_a_different_random_jwt_refresh_secret_min_32_characters_222222

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# 4. Initial Database Seeding
# Set to "true" if you want the demo colleges, hostels, rooms, and users populated.
# Set to "false" if you are launching a clean, production-ready system.
SEED_DB=false
