# ---- Server ----
NODE_ENV=development
PORT=5000
# Origin of the frontend (CORS is limited to this origin)
CORS_ORIGIN=http://localhost:5173

# ---- MySQL 8 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=hostel_management

# ---- Auth ----
# Use long random strings (at least 32 characters each, and different from each other).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret_min_32_chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
